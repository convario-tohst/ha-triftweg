                  "grid_options": {
                    "columns": "full"
                  },
                  "chips": [
                    {
                      "type": "template",
                      "icon": "mdi:sofa",
                      "content": "Relax",
                      "icon_color": "red",
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "scene.turn_on",
                        "target": {
                          "entity_id": "scene.relax"
                        }
                      }
                    },
                    {
                      "type": "template",
                      "icon": "mdi:chef-hat",
                      "content": "Kochen",
                      "icon_color": "orange",
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "scene.turn_on",
                        "target": {
                          "entity_id": "scene.kochen"
                        }
                      }
                    },
                    {
                      "type": "template",
                      "icon": "mdi:silverware-fork-knife",
                      "content": "Dinner",
                      "icon_color": "purple",
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "scene.turn_on",
                        "target": {
                          "entity_id": "scene.dinner"
                        }
                      }
                    },
                    {
                      "type": "template",
                      "icon": "mdi:party-popper",
                      "content": "Party",
                      "icon_color": "pink",
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "scene.turn_on",
                        "target": {
                          "entity_id": "scene.party"
                        }
                      }
                    },
                    {
                      "type": "template",
                      "icon": "mdi:power",
                      "content": "Aus",
                      "icon_color": "grey",
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "scene.turn_on",
                        "target": {
                          "entity_id": "scene.aus"
                        }
                      }
                    }

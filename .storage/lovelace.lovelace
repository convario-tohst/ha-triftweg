                  "icon": "mdi:speedometer",
                  "color": "teal",
                  "grid_options": {
                    "columns": 4
                  }
                },
                {
                  "type": "tile",
                  "entity": "sensor.cloud_gateway_max_tobias_cpu_auslastung",
                  "name": "Gateway CPU",
                  "icon": "mdi:cpu-64-bit",
                  "color": "orange",
                  "grid_options": {
                    "columns": 4
                  }
                },
                {
                  "type": "tile",
                  "entity": "sensor.cloud_gateway_max_tobias_cpu_temperatur",
                  "name": "Gateway Temp.",
                  "icon": "mdi:thermometer",
                  "color": "red",
                  "grid_options": {
                    "columns": 4
                  }
                },
                {
                  "type": "history-graph",
                  "title": "Durchsatz 24 h",
                  "hours_to_show": 24,
                  "grid_options": {
                    "columns": "full"
                  },
                  "entities": [
                    {
                      "entity": "sensor.netz_download",
                      "name": "Download"
                    },
                    {
                      "entity": "sensor.netz_upload",
                      "name": "Upload"
                    }
                  ]
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Wer nutzt gerade das Netz",
                  "icon": "mdi:podium"
                },
                {
                  "type": "markdown",
                  "content": "| Gerät | ⬇ Mbit/s | ⬆ Mbit/s |\n|---|---:|---:|\n{% for x in state_attr('sensor.netz_top_verbraucher','liste') or [] %}| {{ x.name }} | {{ x.down }} | {{ x.up }} |\n{% endfor %}",
                  "grid_options": {
                    "columns": "full"
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Alle Geräte",
                  "icon": "mdi:devices"
                },
                {
                  "type": "markdown",
                  "content": "{% set l = states.device_tracker | selectattr('attributes.mac','defined') | list %}**{{ l | selectattr('state','eq','home') | list | count }} online**, {{ l | rejectattr('state','eq','home') | list | count }} offline\n\n| | Gerät | IP |\n|---|---|---|\n{% for d in l | sort(attribute='state') %}| {{ '🟢' if d.state == 'home' else '⚪' }} | {{ d.name }} | {{ d.attributes.get('ip', '') }} |\n{% endfor %}",
                  "grid_options": {
                    "columns": "full"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
                  "icon": "mdi:motion-sensor",
                  "color": "green",
                  "features": [
                    {
                      "type": "select-options"
                    }
                  ],
                  "features_position": "inline",
                  "grid_options": {
                    "columns": "full"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "sections",
          "path": "raum-sauna",
          "title": "Sauna",
          "icon": "mdi:hot-tub",
          "subview": true,
          "back_path": "/lovelace/raeume",
          "max_columns": 2,
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Sauna",
                  "icon": "mdi:hot-tub"
                },
                {
                  "type": "tile",
                  "entity": "climate.heizung_sauna",
                  "name": "Heizung",
                  "color": "deep-orange",
                  "grid_options": {
                    "columns": "full"
                  },
                  "features": [
                    {
                      "type": "target-temperature"
                    }
                  ],
                  "features_position": "inline"
                },
                {
                  "type": "tile",
                  "entity": "switch.saunaofen",
                  "name": "Saunaofen",
                  "icon": "mdi:fire",
                  "color": "red",
                  "grid_options": {
                    "columns": "full"
                  },
                  "features": [
                    {
                      "type": "toggle"
                    }
                  ],
                  "features_position": "inline"
                },
                {
                  "type": "tile",
                  "entity": "light.sauna_decke",
                  "name": "Decke",
                  "color": "amber",
                  "vertical": false,
                  "grid_options": {
                    "columns": 6,
                    "rows": 2
                  },
                  "features": [
                    {
                      "type": "light-brightness"
                    }
                  ],
                  "features_position": "bottom"
                },
                {
                  "type": "tile",
                  "entity": "light.licht_sauna_wand",
                  "name": "Wand",
                  "color": "amber",
                  "vertical": false,
                  "grid_options": {
                    "columns": 6,
                    "rows": 2
                  },
                  "icon": "mdi:wall-sconce",
                  "features": [
                    {
                      "type": "light-brightness"
                    }
                  ],
                  "features_position": "bottom"
                },
                {
                  "type": "tile",
                  "entity": "fan.sauna_luftung",
                  "name": "Lüftung",
                  "features": [
                    {
                      "type": "fan-speed"
                    },
                    {
                      "type": "fan-preset-modes",
                      "style": "dropdown"
                    }
                  ],
                  "grid_options": {
                    "columns": "full"
                  }
                },
                {
                  "type": "tile",
                  "entity": "sensor.sauna_luftung",
                  "name": "Feuchte",
                  "grid_options": {
                    "columns": 6
                  }
                },
                {
                  "type": "tile",
                  "entity": "input_boolean.sauna_lueftung_automatik",
                  "name": "Lüftung automatisch",
                  "features": [
                    {
                      "type": "toggle"
                    }
                  ],
                  "grid_options": {
                    "columns": 6
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Raumklima",
                  "icon": "mdi:home-thermometer-outline",
                  "heading_style": "subtitle"
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Temperatur",
                  "secondary": "{% set v = states('sensor.temperatur_sauna_aufenthaltsraum') %}{{ (v | float | round(1) | string ~ ' °C') if is_number(v) else 'keine Daten' }}",
                  "icon": "mdi:thermometer",
                  "icon_color": "deep-orange",
                  "fill_container": true,
                  "grid_options": {
                    "columns": 6,
                    "rows": 1
                  },
                  "tap_action": {
                    "action": "more-info"
                  },
                  "entity": "sensor.temperatur_sauna_aufenthaltsraum"
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Feuchte",
                  "secondary": "{% set v = states('sensor.feuchte_sauna_aufenthaltsraum') %}{{ (v | float | round(0) | string ~ ' %') if is_number(v) else 'keine Daten' }}{% set a = states('sensor.absolute_feuchte_sauna_aufenthaltsraum') %}{{ (' · ' ~ a | float | round(1) | string ~ ' g/m³') if is_number(a) }}",
                  "icon": "mdi:water-percent",
                  "icon_color": "{% set f = states('sensor.feuchte_sauna_aufenthaltsraum') %}{{ 'grey' if not is_number(f) else 'blue' if f | float < 35 else 'green' if f | float <= 50 else 'amber' if f | float <= 60 else 'red' }}",
                  "fill_container": true,
                  "grid_options": {
                    "columns": 6,
                    "rows": 1
                  },
                  "tap_action": {
                    "action": "more-info"
                  },
                  "entity": "sensor.feuchte_sauna_aufenthaltsraum"
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Taupunkt",
                  "secondary": "{% set v = states('sensor.taupunkt_sauna_aufenthaltsraum') %}{{ (v | float | round(1) | string ~ ' °C') if is_number(v) else 'keine Daten' }}",
                  "icon": "mdi:thermometer-water",
                  "icon_color": "cyan",
                  "fill_container": true,
                  "grid_options": {
                    "columns": 6,
                    "rows": 1
                  },
                  "tap_action": {
                    "action": "more-info"
                  },
                  "entity": "sensor.taupunkt_sauna_aufenthaltsraum"
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Helligkeit",
                  "secondary": "{% set v = states('sensor.helligkeit_sauna_aufenthaltsraum') %}{{ (v | float | round(0) | string ~ ' lx') if is_number(v) else 'keine Daten' }}",
                  "icon": "mdi:brightness-6",
                  "icon_color": "yellow",
                  "fill_container": true,
                  "grid_options": {
                    "columns": 6,
                    "rows": 1
                  },
                  "tap_action": {
                    "action": "more-info"
                  },
                  "entity": "sensor.helligkeit_sauna_aufenthaltsraum"
                },
                {
                  "type": "history-graph",
                  "title": "Letzte 48 Stunden",
                  "hours_to_show": 48,
                  "grid_options": {
                    "columns": "full"
                  },
                  "entities": [
                    {
                      "entity": "sensor.temperatur_sauna_aufenthaltsraum",
                      "name": "Temperatur"
                    },
                    {
                      "entity": "sensor.feuchte_sauna_aufenthaltsraum",
                      "name": "Feuchte"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "sections",
          "path": "raum-werkstatt",
          "title": "Werkstatt",
          "icon": "mdi:tools",
          "subview": true,
          "back_path": "/lovelace/raeume",
          "max_columns": 2,
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Werkstatt",
                  "icon": "mdi:tools"
                },
                {
                  "type": "tile",
                  "entity": "light.werkstatt",

            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Raumklima",
                  "icon": "mdi:home-thermometer-outline",
                  "heading_style": "subtitle"
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Temperatur",
                  "secondary": "{% set v = states('sensor.temperatur_wohnzimmer') %}{{ (v | float | round(1) | string ~ ' °C') if is_number(v) else 'keine Daten' }}",
                  "icon": "mdi:thermometer",
                  "icon_color": "deep-orange",
                  "fill_container": true,
                  "grid_options": {
                    "columns": 6,
                    "rows": 1
                  },
                  "tap_action": {
                    "action": "more-info"
                  },
                  "entity": "sensor.temperatur_wohnzimmer"
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Feuchte",
                  "secondary": "{% set v = states('sensor.feuchte_wohnzimmer') %}{{ (v | float | round(0) | string ~ ' %') if is_number(v) else 'keine Daten' }}{% set a = states('sensor.absolute_feuchte_wohnzimmer') %}{{ (' · ' ~ a | float | round(1) | string ~ ' g/m³') if is_number(a) }}",
                  "icon": "mdi:water-percent",
                  "icon_color": "{% set f = states('sensor.feuchte_wohnzimmer') %}{{ 'grey' if not is_number(f) else 'blue' if f | float < 35 else 'green' if f | float <= 50 else 'amber' if f | float <= 60 else 'red' }}",
                  "fill_container": true,
                  "grid_options": {
                    "columns": 6,
                    "rows": 1
                  },
                  "tap_action": {
                    "action": "more-info"
                  },
                  "entity": "sensor.feuchte_wohnzimmer"
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Taupunkt",
                  "secondary": "{% set v = states('sensor.taupunkt_wohnzimmer') %}{{ (v | float | round(1) | string ~ ' °C') if is_number(v) else 'keine Daten' }}",
                  "icon": "mdi:thermometer-water",
                  "icon_color": "cyan",
                  "fill_container": true,
                  "grid_options": {
                    "columns": 6,
                    "rows": 1
                  },
                  "tap_action": {
                    "action": "more-info"
                  },
                  "entity": "sensor.taupunkt_wohnzimmer"
                },
                {

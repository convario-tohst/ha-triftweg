{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.lovelace",
  "data": {
    "config": {
      "title": "Home",
      "views": [
        {
          "type": "sections",
          "path": "default_view",
          "title": "Home",
          "icon": "mdi:home",
          "max_columns": 3,
          "badges": [
            {
              "type": "entity",
              "entity": "sensor.vallox_filter_resttage",
              "name": "Filter",
              "icon": "mdi:air-filter",
              "color": "red",
              "visibility": [
                {
                  "condition": "state",
                  "entity": "binary_sensor.vallox_filter_fallig",
                  "state": "on"
                }
              ]
            },
            {
              "type": "entity",
              "entity": "conversation.home_assistant",
              "name": "Sprechen",
              "icon": "mdi:microphone",
              "show_name": true,
              "show_state": false,
              "show_icon": true,
              "color": "blue",
              "tap_action": {
                "action": "assist",
                "start_listening": true
              }
            },
            {
              "type": "entity",
              "entity": "sensor.mull_nachste_abholung",
              "name": "Müll",
              "icon": "mdi:trash-can",
              "show_name": true,
              "show_state": true,
              "show_icon": true,
              "color": "brown"
            },
            {
              "type": "entity",
              "entity": "person.tobias_ohst",
              "name": "Tobias",
              "icon": "mdi:account",
              "show_name": true,
              "show_state": true,
              "show_icon": true,
              "color": "green"
            },
            {
              "type": "entity",
              "entity": "person.yvonne_ohst",
              "name": "Yvonne",
              "icon": "mdi:account",
              "show_name": true,
              "show_state": true,
              "show_icon": true,
              "color": "green"
            },
            {
              "type": "entity",
              "entity": "person.malte_ohst",
              "name": "Malte",
              "icon": "mdi:account",
              "show_name": true,
              "show_state": true,
              "show_icon": true,
              "color": "green"
            }
          ],
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Klima außen",
                  "heading_style": "title",
                  "icon": "mdi:tree",
                  "badges": [
                    {
                      "type": "entity",
                      "entity": "binary_sensor.frostwarnung",
                      "show_state": true,
                      "show_icon": true,
                      "color": "light-blue",
                      "state_content": "name",
                      "visibility": [
                        {
                          "condition": "state",
                          "entity": "binary_sensor.frostwarnung",
                          "state": "on"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "tile",
                  "entity": "sensor.temperatur_aussen",
                  "name": "Temperatur",
                  "icon": "mdi:thermometer",
                  "color": "deep-orange",
                  "vertical": true,
                  "grid_options": {
                    "columns": 3,
                    "rows": 2
                  }
                },
                {
                  "type": "tile",
                  "entity": "sensor.luftfeuchtigkeit_aussen",
                  "name": "Feuchte",
                  "icon": "mdi:water-percent",
                  "color": "light-blue",
                  "vertical": true,
                  "grid_options": {
                    "columns": 3,
                    "rows": 2
                  }
                },
                {
                  "type": "tile",
                  "entity": "sensor.taupunkt_aussen",
                  "name": "Taupunkt",
                  "icon": "mdi:water-thermometer",
                  "color": "cyan",
                  "vertical": true,
                  "grid_options": {
                    "columns": 3,
                    "rows": 2
                  }
                },
                {
                  "type": "tile",
                  "entity": "sensor.tiefstwert_aussen_48_h",
                  "name": "Tiefst 48 h",
                  "icon": "mdi:snowflake-thermometer",
                  "color": "indigo",
                  "vertical": true,
                  "grid_options": {
                    "columns": 3,
                    "rows": 2
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Klima innen",
                  "heading_style": "title",
                  "icon": "mdi:home-thermometer",
                  "badges": [
                    {
                      "type": "entity",
                      "entity": "sensor.luftung_feuchte_modus",
                      "show_state": true,
                      "show_icon": true,
                      "color": "teal"
                    }
                  ]
                },
                {
                  "type": "tile",
                  "entity": "sensor.feuchte_eg",
                  "name": "Feuchte EG",
                  "icon": "mdi:home-floor-g",
                  "color": "blue",
                  "vertical": true,
                  "grid_options": {
                    "columns": 3,
                    "rows": 2
                  }
                },
                {
                  "type": "tile",
                  "entity": "sensor.feuchte_og",
                  "name": "Feuchte OG",
                  "icon": "mdi:home-floor-1",
                  "color": "blue",
                  "vertical": true,
                  "grid_options": {
                    "columns": 3,
                    "rows": 2
                  }
                },
                {
                  "type": "tile",
                  "entity": "sensor.taupunkt_innen",
                  "name": "Taupunkt",
                  "icon": "mdi:water-thermometer-outline",
                  "color": "cyan",
                  "vertical": true,
                  "grid_options": {
                    "columns": 3,
                    "rows": 2
                  }
                },
                {
                  "type": "tile",
                  "entity": "sensor.vallox_luftergeschwindigkeit",
                  "name": "Lüftung",
                  "icon": "mdi:fan",
                  "color": "teal",
                  "vertical": true,
                  "grid_options": {
                    "columns": 3,
                    "rows": 2
                  },
                  "tap_action": {
                    "action": "more-info"
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Schnell",
                  "icon": "mdi:lightning-bolt"
                },
                {
                  "type": "tile",
                  "entity": "script.ich_gehe_ins_bett",
                  "name": "Ich gehe ins Bett",
                  "icon": "mdi:bed",
                  "hide_state": true,
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "script.ich_gehe_ins_bett"
                  },
                  "grid_options": {
                    "columns": 6
                  }
                },
                {
                  "type": "tile",
                  "entity": "script.alles_aus",
                  "name": "Alles aus",
                  "icon": "mdi:power",
                  "hide_state": true,
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "script.alles_aus"
                  },
                  "grid_options": {
                    "columns": 6
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.vallox_filter_fallig",
                      "state": "on"
                    }
                  ],
                  "card": {
                    "type": "tile",
                    "entity": "sensor.vallox_filter_resttage",
                    "name": "Vallox-Filter wechseln (Tage)",
                    "icon": "mdi:air-filter",
                    "color": "red",
                    "grid_options": {
                      "columns": "full"
                    }
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:mushroom-chips-card",
                  "alignment": "center",
                  "grid_options": {
                    "columns": "full"
                  },
                  "chips": [
                    {
                      "type": "template",
                      "icon": "mdi:floor-plan",
                      "content": "Räume",
                      "icon_color": "amber",
                      "tap_action": {
                        "action": "navigate",
                        "navigation_path": "/lovelace/raeume"
                      }
                    },
                    {
                      "type": "template",
                      "icon": "mdi:robot",
                      "content": "Automatik",
                      "icon_color": "deep-purple",
                      "tap_action": {
                        "action": "navigate",
                        "navigation_path": "/lovelace/zeiten"
                      }
                    },
                    {
                      "type": "template",
                      "icon": "mdi:music",
                      "content": "Musik",
                      "icon_color": "pink",
                      "tap_action": {
                        "action": "navigate",
                        "navigation_path": "/lovelace/musik"
                      }
                    },
                    {
                      "type": "template",
                      "icon": "mdi:cctv",
                      "content": "Kameras",
                      "icon_color": "blue",
                      "tap_action": {
                        "action": "navigate",
                        "navigation_path": "/lovelace/kamera"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "grid",
              "id": "muell_alarm",
              "cards": [
                {
                  "type": "conditional",
                  "grid_options": {
                    "columns": "full"
                  },
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "input_boolean.muell_alarm_aktiv",
                      "state": "on"
                    }
                  ],
                  "card": {
                    "type": "custom:mushroom-template-card",
                    "primary": "🗑️ {{ states('input_text.muell_alarm_tonne') }} – Tonne rausgestellt?",
                    "secondary": "Tippen = erledigt (Stripe hört auf zu blinken)",
                    "icon": "mdi:trash-can-outline",
                    "icon_color": "red",
                    "fill_container": true,
                    "tap_action": {
                      "action": "perform-action",
                      "perform_action": "input_boolean.turn_on",
                      "target": {
                        "entity_id": "input_boolean.muell_erledigt"
                      }
                    }
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Musik",
                  "icon": "mdi:music",
                  "badges": [
                    {
                      "type": "entity",
                      "entity": "media_player.ma_wohnzimmer",
                      "name": "Alle Listen",
                      "icon": "mdi:playlist-music",
                      "show_state": false,
                      "show_name": true,
                      "tap_action": {
                        "action": "navigate",
                        "navigation_path": "/lovelace/musik"
                      }
                    }
                  ]
                },
                {
                  "type": "heading",
                  "heading": "Wohnzimmer & Küche",
                  "icon": "mdi:sofa",
                  "heading_style": "subtitle"
                },
                {
                  "type": "custom:mushroom-media-player-card",
                  "entity": "media_player.ma_wohnzimmer",
                  "name": "Wohnzimmer & Küche",
                  "icon": "mdi:speaker",
                  "use_media_info": true,
                  "show_volume_level": true,
                  "volume_controls": [
                    "volume_buttons",
                    "volume_set",
                    "volume_mute"
                  ],
                  "media_controls": [
                    "play_pause_stop",
                    "previous",
                    "next"
                  ],
                  "collapsible_controls": false,
                  "grid_options": {
                    "columns": "full"
                  }
                },
                {
                  "type": "heading",
                  "heading": "Schlafzimmer",
                  "icon": "mdi:bed-king",
                  "heading_style": "subtitle"
                },
                {
                  "type": "custom:mushroom-media-player-card",
                  "entity": "media_player.ma_schlafzimmer",
                  "name": "Schlafzimmer",
                  "icon": "mdi:speaker",
                  "use_media_info": true,
                  "show_volume_level": true,
                  "volume_controls": [
                    "volume_buttons",
                    "volume_set",
                    "volume_mute"
                  ],
                  "media_controls": [
                    "play_pause_stop",
                    "previous",
                    "next"
                  ],
                  "collapsible_controls": false,
                  "grid_options": {
                    "columns": "full"
                  }
                },
                {
                  "type": "tile",
                  "entity": "script.musik_ueberrasch_mich",
                  "name": "Überrasch mich",
                  "icon": "mdi:dice-5",
                  "color": "deep-orange",
                  "hide_state": true,
                  "grid_options": {
                    "columns": 6,
                    "rows": 1
                  },
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "script.musik_ueberrasch_mich"
                  },
                  "icon_tap_action": {
                    "action": "perform-action",
                    "perform_action": "script.musik_ueberrasch_mich"
                  }
                },
                {
                  "type": "tile",
                  "entity": "script.musik_aus",
                  "name": "Musik aus",
                  "icon": "mdi:music-off",
                  "color": "grey",
                  "hide_state": true,
                  "grid_options": {
                    "columns": 6,
                    "rows": 1
                  },
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "script.musik_aus",
                    "data": {
                      "raum": "Beide"
                    }
                  },
                  "icon_tap_action": {
                    "action": "perform-action",
                    "perform_action": "script.musik_aus",
                    "data": {
                      "raum": "Beide"
                    }
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Heizung",
                  "secondary": "{% set z = ['climate.heizung_wohnzimmer','climate.heizung_obergeschoss_3','climate.heizung_bad_yvonne_2','climate.heizung_flur_eg','climate.heizung_ankleide','climate.heizung_hwr','climate.heizung_sauna'] %}Ø {{ (z | map('state_attr','current_temperature') | select('number') | list | average(0)) | round(1) }} °C · {{ z | select('is_state_attr','hvac_action','heating') | list | count }} heizen",
                  "icon": "mdi:radiator",
                  "icon_color": "deep-orange",
                  "badge_color": "grey",
                  "badge_icon": "{{ 'mdi:chevron-up' if is_state('input_boolean.dash_heizung', 'on') else 'mdi:chevron-down' }}",
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "input_boolean.toggle",
                    "target": {
                      "entity_id": "input_boolean.dash_heizung"
                    }
                  },
                  "grid_options": {
                    "columns": "full"
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "input_boolean.dash_heizung",
                      "state": "on"
                    }
                  ],
                  "card": {
                    "type": "vertical-stack",
                    "cards": [
                      {
                        "type": "tile",
                        "entity": "climate.heizung_wohnzimmer",
                        "name": "Wohnen / Küche",
                        "color": "deep-orange",
                        "grid_options": {
                          "columns": "full"
                        },
                        "features": [
                          {
                            "type": "target-temperature"
                          }
                        ],
                        "features_position": "inline"
                      },
                      {
                        "type": "tile",
                        "entity": "climate.heizung_obergeschoss_3",
                        "name": "Obergeschoss",
                        "color": "deep-orange",
                        "grid_options": {
                          "columns": "full"
                        },
                        "features": [
                          {
                            "type": "target-temperature"
                          }
                        ],
                        "features_position": "inline"
                      },
                      {
                        "type": "tile",
                        "entity": "climate.heizung_bad_yvonne_2",
                        "name": "Bad Yvonne",
                        "color": "deep-orange",
                        "grid_options": {
                          "columns": "full"
                        },
                        "features": [
                          {
                            "type": "target-temperature"
                          }
                        ],
                        "features_position": "inline"
                      },
                      {
                        "type": "tile",
                        "entity": "climate.heizung_flur_eg",
                        "name": "Flur EG",
                        "color": "deep-orange",
                        "grid_options": {
                          "columns": "full"
                        },
                        "features": [
                          {
                            "type": "target-temperature"
                          }
                        ],
                        "features_position": "inline"
                      },
                      {
                        "type": "tile",
                        "entity": "climate.heizung_ankleide",
                        "name": "Ankleide",
                        "color": "deep-orange",
                        "grid_options": {
                          "columns": "full"
                        },
                        "features": [
                          {
                            "type": "target-temperature"
                          }
                        ],
                        "features_position": "inline"
                      },
                      {
                        "type": "tile",
                        "entity": "climate.heizung_hwr",
                        "name": "HWR",
                        "color": "deep-orange",
                        "grid_options": {
                          "columns": "full"
                        },
                        "features": [
                          {
                            "type": "target-temperature"
                          }
                        ],
                        "features_position": "inline"
                      },
                      {
                        "type": "tile",
                        "entity": "climate.heizung_sauna",
                        "name": "Sauna",
                        "color": "deep-orange",
                        "grid_options": {
                          "columns": "full"
                        },
                        "features": [
                          {
                            "type": "target-temperature"
                          }
                        ],
                        "features_position": "inline"
                      }
                    ]
                  },
                  "grid_options": {
                    "columns": "full"
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Zuhause",
                  "icon": "mdi:home-heart",
                  "heading_style": "title"
                },
                {
                  "type": "tile",
                  "entity": "input_boolean.kinder_wach_alarm",
                  "name": "Kinder-wach-Alarm",
                  "icon": "mdi:baby-face-outline",
                  "color": "purple",
                  "features": [
                    {
                      "type": "toggle"
                    }
                  ],
                  "features_position": "inline",
                  "grid_options": {
                    "columns": "full"
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "input_boolean.haus_abwesend",
                      "state": "on"
                    }
                  ],
                  "grid_options": {
                    "columns": "full"
                  },
                  "card": {
                    "type": "tile",
                    "entity": "input_boolean.haus_abwesend",
                    "name": "Abwesend – Rückkehr wird automatisch erkannt",
                    "icon": "mdi:home-export-outline",
                    "color": "red",
                    "features": [
                      {
                        "type": "toggle"
                      }
                    ],
                    "features_position": "inline"
                  }
                },
                {
                  "type": "tile",
                  "entity": "script.haus_verlassen",
                  "name": "Haus verlassen",
                  "color": "red",
                  "grid_options": {
                    "columns": 6
                  },
                  "icon": "mdi:exit-run",
                  "hide_state": true,
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "script.haus_verlassen",
                    "confirmation": {
                      "text": "Alle Lichter aus, Lüftung auf Abwesend, Musik/TV und Saunaofen aus?"
                    }
                  },
                  "icon_tap_action": {
                    "action": "perform-action",
                    "perform_action": "script.haus_verlassen",
                    "confirmation": {
                      "text": "Alle Lichter aus, Lüftung auf Abwesend, Musik/TV und Saunaofen aus?"
                    }
                  }
                },
                {
                  "type": "tile",
                  "entity": "input_boolean.alles_an",
                  "name": "Alles an",
                  "color": "amber",
                  "grid_options": {
                    "columns": 6
                  },
                  "icon": "mdi:lightbulb-group",
                  "tap_action": {
                    "action": "toggle"
                  },
                  "icon_tap_action": {
                    "action": "toggle"
                  }
                },
                {
                  "type": "tile",
                  "entity": "script.alle_lichter_aus",
                  "name": "Alle Lichter aus",
                  "icon": "mdi:lightbulb-group-off",
                  "color": "blue-grey",
                  "hide_state": true,
                  "grid_options": {
                    "columns": 6
                  },
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "script.alle_lichter_aus"
                  },
                  "icon_tap_action": {
                    "action": "perform-action",
                    "perform_action": "script.alle_lichter_aus"
                  }
                },
                {
                  "type": "tile",
                  "entity": "input_boolean.disco",
                  "name": "Disco",
                  "color": "pink",
                  "grid_options": {
                    "columns": 6
                  },
                  "icon": "mdi:party-popper",
                  "tap_action": {
                    "action": "toggle"
                  },
                  "icon_tap_action": {
                    "action": "toggle"
                  }
                },
                {
                  "type": "tile",
                  "entity": "input_boolean.urlaub",
                  "name": "Urlaub",
                  "color": "light-blue",
                  "grid_options": {
                    "columns": 6
                  },
                  "icon": "mdi:airplane",
                  "tap_action": {
                    "action": "toggle"
                  },
                  "icon_tap_action": {
                    "action": "toggle"
                  }
                },
                {
                  "type": "tile",
                  "entity": "input_boolean.einfahrt_licht_fremde",
                  "name": "Licht bei Fremden",
                  "icon": "mdi:account-alert",
                  "color": "orange",
                  "grid_options": {
                    "columns": "full"
                  },
                  "features": [
                    {
                      "type": "toggle"
                    }
                  ],
                  "features_position": "inline"
                },
                {
                  "type": "tile",
                  "entity": "sensor.mull_nachste_abholung",
                  "name": "Nächste Müllabfuhr",
                  "color": "brown",
                  "grid_options": {
                    "columns": "full"
                  },
                  "icon": "mdi:trash-can"
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Wetter",
                  "icon": "mdi:weather-partly-cloudy"
                },
                {
                  "type": "tile",
                  "entity": "weather.forecast_home",
                  "name": "Oldenburg",
                  "grid_options": {
                    "columns": "full"
                  }
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Windy",
                  "secondary": "Wind, Regen, Radar",
                  "icon": "mdi:weather-windy",
                  "icon_color": "light-blue",
                  "badge_color": "grey",
                  "badge_icon": "{{ 'mdi:chevron-up' if is_state('input_boolean.dash_wetter_karte', 'on') else 'mdi:chevron-down' }}",
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "input_boolean.toggle",
                    "target": {
                      "entity_id": "input_boolean.dash_wetter_karte"
                    }
                  },
                  "grid_options": {
                    "columns": "full"
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "input_boolean.dash_wetter_karte",
                      "state": "on"
                    }
                  ],
                  "card": {
                    "type": "iframe",
                    "aspect_ratio": "110%",
                    "url": "https://embed.windy.com/embed2.html?lat=53.2&lon=8.2&detailLat=53.2&detailLon=8.2&zoom=8&level=surface&overlay=wind&product=ecmwf&menu=&message=true&marker=&calendar=now&pressure=true&type=map&location=coordinates&detail=true&metricWind=kt&metricTemp=%C2%B0C&radarRange=-1"
                  },
                  "grid_options": {
                    "columns": "full"
                  }
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Ballonwetter",
                  "secondary": "{{ states('sensor.ballon_morgenfahrt')[:1] }} morgens · {{ states('sensor.ballon_abendfahrt')[:1] }} abends",
                  "icon": "mdi:airballoon",

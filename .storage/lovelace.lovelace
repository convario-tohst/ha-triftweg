          ]
        },
        {
          "type": "sections",
          "path": "systemtest",
          "title": "Systemtest",
          "icon": "mdi:clipboard-check-outline",
          "max_columns": 2,
          "sections": [
            {
              "type": "grid",
              "column_span": 2,
              "cards": [
                {
                  "type": "heading",
                  "heading": "Systemtest",
                  "icon": "mdi:clipboard-check-outline"
                },
                {
                  "type": "tile",
                  "entity": "script.systemtest_starten",
                  "name": "Test starten",
                  "icon": "mdi:play-circle",
                  "hide_state": true,
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "script.systemtest_starten"
                  },
                  "grid_options": {
                    "columns": 6
                  }
                },
                {
                  "type": "tile",
                  "entity": "script.systemtest_mit_sprache",
                  "name": "Test mit Sprachtest",
                  "icon": "mdi:account-voice",
                  "hide_state": true,
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "script.systemtest_mit_sprache"
                  },
                  "grid_options": {
                    "columns": 6
                  }
                },
                {
                  "type": "markdown",
                  "content": "{% set s = states('sensor.systemtest') %}{% if s == 'läuft' %}⏳ **Test läuft …**{% elif s == 'ok' %}✅ **Alles in Ordnung**{% else %}{{ '🔴' if state_attr('sensor.systemtest','fehler_anzahl') | int(0) > 0 else '🟡' }} **{{ s }}**{% endif %}  \n{{ state_attr('sensor.systemtest','bestanden') }} von {{ state_attr('sensor.systemtest','gesamt') }} Prüfungen bestanden · {{ state_attr('sensor.systemtest','warnungen') }} Warnungen · {{ state_attr('sensor.systemtest','zeit') }} ({{ state_attr('sensor.systemtest','dauer') }} s)  \n<small>Der Test schaltet nichts – er liest nur Zustände, Konfiguration, Protokolle und fragt Melder am Bus ab.</small>",
                  "grid_options": {
                    "columns": "full"
                  }
                },
                {
                  "type": "markdown",
                  "content": "{% set p = state_attr('sensor.systemtest','probleme') or [] %}{% set namen = {1: '🔴 Priorität 1 – Präsenz, Licht, KNX', 2: '🟠 Priorität 2 – Heizung, Klima, System', 3: '🔵 Priorität 3 – Komfort'} %}{% for prio in [1, 2, 3] %}{% set liste = p | selectattr('p', 'eq', prio) | rejectattr('s', 'eq', 'info') | list %}{% if liste %}### {{ namen[prio] }}\n{% for x in liste %}- {{ '❌' if x.s == 'fehler' else '⚠️' }} **{{ x.t }}**{{ (' – ' ~ x.i) if x.i else '' }}\n{% endfor %}{% endif %}{% endfor %}{% if not (p | rejectattr('s', 'eq', 'info') | list) %}✅ Keine Fehler oder Warnungen{% endif %}",
                  "grid_options": {
                    "columns": "full"
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Übersicht nach Bereich",
                  "icon": "mdi:format-list-checks"
                },
                {
                  "type": "markdown",
                  "content": "| | Bereich | ✅ | ⚠️ | ❌ |\n|---|---|---|---|---|\n{% for k, v in (state_attr('sensor.systemtest','kategorien') or {}) | dictsort %}{% set t = k.split('|') %}| P{{ t[0] }} | {{ t[1] }} | {{ v.ok + v.info }} | {{ v.warnung }} | {{ v.fehler }} |\n{% endfor %}",
                  "grid_options": {
                    "columns": "full"
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Ausgeschaltete Automationen",
                  "icon": "mdi:pause-circle-outline"
                },
                {
                  "type": "markdown",
                  "content": "{% set p = (state_attr('sensor.systemtest','probleme') or []) | selectattr('s', 'eq', 'info') | list %}{% for x in p %}- ⏸️ {{ x.t }}{{ (' – ' ~ x.i) if x.i else '' }}\n{% endfor %}{% if not p %}Keine{% endif %}",
                  "grid_options": {
                    "columns": "full"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "sections",
          "path": "netzwerk",
          "title": "Netzwerk",
          "icon": "mdi:lan",
          "max_columns": 3,
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Internet & Gateway",
                  "icon": "mdi:router-network"
                },
                {
                  "type": "tile",
                  "entity": "sensor.netz_download",

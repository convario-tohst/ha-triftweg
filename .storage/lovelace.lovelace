                  "primary": "Helligkeit",
                  "secondary": "{% set v = states('sensor.helligkeit_wohnzimmer') %}{{ (v | float | round(0) | string ~ ' lx') if is_number(v) else 'keine Daten' }}",
                  "icon": "mdi:brightness-6",
                  "icon_color": "yellow",
                  "fill_container": true,
                  "grid_options": {
                    "columns": 6,
                    "rows": 1
                  },
                  "tap_action": {
                    "action": "more-info"
                  },
                  "entity": "sensor.helligkeit_wohnzimmer"
                },
                {
                  "type": "history-graph",
